# ---- Required ----
# Session signing secret: any long random string.
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key that encrypts mailbox passwords at rest. Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# Password for the single owner login.
OWNER_PASSWORD=change-me
# Public URL of this server, used for one-click unsubscribe links. Must be reachable by recipients
# (use HTTPS in production, e.g. https://coldlane.example.com). Campaigns cannot start without it.
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Mandatory footer identity. Can be overridden in Settings (or per mailbox for the address).
SENDER_BUSINESS_NAME=Your Agency LLC
SENDER_ADDRESS=123 Main Street, Suite 100, Springfield, IL 62701, USA

# ---- Optional (defaults shown) ----
PORT=8080
DATABASE_PATH=/data/coldlane.db
DEFAULT_DAILY_CAP=30
RAMP_START=10
RAMP_STEP=5
MIN_GAP_SECONDS=90
MAX_GAP_SECONDS=240
RECIPIENT_DOMAIN_PER_HOUR=10
MAX_BOUNCE_RATE=0.05
WORKER_TICK_SECONDS=30
IMAP_POLL_SECONDS=300

# ---- Test profile helpers only (used by coldlane.scripts.*; defaults shown) ----
GREENMAIL_HOST=greenmail
GREENMAIL_SMTP_PORT=3025
GREENMAIL_IMAP_PORT=3143
